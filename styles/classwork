header {
  text-align: center;
  margin: 40px 0;
}

main {
  max-width: 900px;
  margin: auto;
  background-color: rgb(39, 24, 148);
  padding: 30px;
  border-radius: 10px;
}

.class-card {
  text-align: center;
  margin: 40px 0;
}

.class-card img {
  width: 200px;
  border-radius: 10px;
}

.class-card h2 {
  margin-top: 15px;
}

.class-card p {
  max-width: 600px;
  margin: 10px auto;
  line-height: 1.6;
}

h1 {
  margin: 50px 0;
}
body {
  outline: 5px solid red;
}

